#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# A small script, run from the *superuser* crontab, that keeps the
# ModSecurity OWASP Core Rule Set (WAF rules) git checkout up to date.
# Run it once a day or every other day, that is just fine.
# A Set-and-Forget solution.

export LC_ALL=C
export LANG=C

repo="/etc/nginx/modsec/coreruleset/"
branch="v3.4/dev"
logfile="/home/$USER/alerter/coreruleset-updates"

log() {
	printf '%s %s\n\n' "$(date)" "$1" >> "$logfile"
}

cd "$repo" || exit 1

if ! git fetch -q; then
	log "git fetch failed, nothing changed."
	exit 1
fi

headhash="$(git rev-parse HEAD)"
upstreamhash="$(git rev-parse "${branch}@{upstream}")"

# If updates are detected: git pull and reload the webserver.
# Human readable lines go to the log file above.

if [[ "$headhash" != "$upstreamhash" ]]; then
	if git pull -q &>/dev/null; then
		sync &>/dev/null
		systemctl reload nginx &>/dev/null
		log "Coreruleset updated from git! GG!!"
	else
		log "Coreruleset update found but git pull failed!"
		exit 1
	fi
else
	log "Just another CRONJOB run - no updates!"
fi
exit 0
