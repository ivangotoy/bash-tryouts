#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# A small script, run from the *superuser* crontab, that keeps the
# ModSecurity OWASP Core Rule Set (WAF rules) git checkout up to date.
# Run it once a day or every other day, that is just fine.
# A Set-and-Forget solution.

export LC_ALL=C
export LANG=C

repo="/etc/nginx/modsec/coreruleset/"
# Root-only (root crontab), so the log has a fixed absolute path.
logfile="/var/log/coreruleset-updates.log"

log() {
	printf '%s %s\n\n' "$(date)" "$1" >> "$logfile"
}

cd "$repo" || exit 1

if ! git fetch -q; then
	log "git fetch failed, nothing changed."
	exit 1
fi

# Follow whatever branch is checked out (e.g. main for CRS v4) and its upstream.
if ! upstream="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" || [[ -z "$upstream" ]]; then
	branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
	log "Branch ${branch:-?} in $repo has no upstream, set one with: git branch -u origin/<branch>"
	printf 'Branch %s in %s has no upstream, nothing changed.\n' "${branch:-?}" "$repo" >&2
	exit 1
fi

headhash="$(git rev-parse HEAD)"
upstreamhash="$(git rev-parse "$upstream")"

# If updates are detected: git pull and reload the webserver.
# Human readable lines go to the log file above.

if [[ "$headhash" != "$upstreamhash" ]]; then
	if git pull -q &>/dev/null; then
		sync &>/dev/null
		if ! systemctl reload nginx &>/dev/null; then
			log "Coreruleset updated from git, but the nginx reload failed! The new rules are not active."
			printf 'Coreruleset updated in %s, but systemctl reload nginx failed; check: nginx -t\n' "$repo" >&2
			exit 1
		fi
		log "Coreruleset updated from git! GG!!"
	else
		log "Coreruleset update found but git pull failed!"
		exit 1
	fi
else
	log "Just another CRONJOB run - no updates!"
fi
exit 0
