#!/usr/bin/env ash
# shellcheck shell=busybox
#
# Cron script for updating the Navidrome audio server running on OpenWrt.
# No systemd, plain busybox ash. Author: Ivan Angelov ivangotoy@gmail.com
#
# Keep the output silent and the run as idempotent as possible:
# - if navidrome is not running, start it
# - if a newer GitHub Actions build exists, download and deploy it
# - no email in any case (cron mails only what is printed)
#
# Files:
#   /mnt/sdb1/token  text file with a valid (not expired) GitHub token
#   /mnt/sdb1/ID     artifact ID of the currently deployed binary
#
# NEWID is the ID of the latest "binaries" artifact of navidrome/navidrome.
# ID is updated only after the new binary has been downloaded and extracted,
# so a failed download is retried on the next run.

set -e

BASE=/mnt/sdb1
API=https://api.github.com/repos/navidrome/navidrome/actions/artifacts
ZIP=/tmp/navidrome.zip
ZIPMEMBER=navidrome_linux_amd64_linux_amd64_v1/navidrome
STAGING="$BASE/Music"

TOKEN="$(cat "$BASE/token")"
OLDID="$(cat "$BASE/ID" 2>/dev/null || true)"

gh_curl() {
	curl -s -f -L \
		-H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" \
		-H "Authorization: Bearer $TOKEN" \
		"$@"
}

# Ensure the navidrome server is up and running.

if ! pidof "$BASE/navidrome/navidrome" >/dev/null; then
	/etc/init.d/navidrome start
fi

# Look for a newer build. One API call, both values come from the same answer.

ARTIFACTS="$(gh_curl "$API" || true)"
NEWID="$(printf '%s\n' "$ARTIFACTS" | grep -B2 'binaries' | head -n 1 | tr -cd '0-9')"
URL="$(printf '%s\n' "$ARTIFACTS" | grep "/$NEWID/zip" | head -n 1 | cut -d '"' -f 4)"

if [ -z "$NEWID" ] || [ -z "$URL" ] || [ "$OLDID" = "$NEWID" ]; then
	exit 0
fi

rm -f "$ZIP"
gh_curl -o "$ZIP" "$URL"
unzip -q -j -o "$ZIP" "$ZIPMEMBER" -d "$STAGING/"
rm -f "$ZIP"
sync

# A freshly extracted binary is waiting in staging: deploy it.

if [ -f "$STAGING/navidrome" ]; then
	chmod +x "$STAGING/navidrome"
	/etc/init.d/navidrome stop
	sync
	sleep 5
	cp "$BASE/navidrome/navidrome" "$BASE/navidrome-backup"
	cp "$BASE/navidrome/navidrome.db" "$BASE/"
	cp "$BASE/navidrome/navidrome.toml" "$BASE/"
	rm -f "$BASE/navidrome/navidrome"
	mv "$STAGING/navidrome" "$BASE/navidrome/"
	printf '%s\n' "$NEWID" > "$BASE/ID"
	sync
	/etc/init.d/navidrome start
fi
