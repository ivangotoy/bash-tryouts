#!/usr/bin/env ash
# shellcheck shell=busybox
#
# Cron script for updating the Navidrome audio server running on OpenWrt.
# No systemd, plain busybox ash. Author: Ivan Angelov ivangotoy@gmail.com
#
# Keep the output silent and the run as idempotent as possible:
# - if navidrome is not running, start it
# - if a newer GitHub release exists, download and deploy it
# - no email in any case (cron mails only what is printed)
#
# The latest release is read from the public GitHub API (no token needed):
#   https://api.github.com/repos/navidrome/navidrome/releases/latest
# and the asset navidrome_<version>_linux_<ARCH>.tar.gz is deployed.
# ARCH defaults to amd64; set it for other routers, e.g. ARCH=arm64 or
# armv7 (see the asset names on the release page).
#
# Files:
#   /mnt/sdb1/ID     release tag of the currently deployed binary
#
# A missing ID file counts as "nothing deployed yet", so the first run
# deploys the latest release. ID is updated only after the new binary has
# been downloaded and extracted, so a failed download is retried on the
# next run.

set -e

ARCH="${ARCH:-amd64}"
BASE=/mnt/sdb1
API=https://api.github.com/repos/navidrome/navidrome/releases/latest
ARCHIVE="${TMPDIR:-/tmp}/navidrome.tar.gz"
STAGING="$BASE/Music"

OLDID="$(cat "$BASE/ID" 2>/dev/null || true)"

# Ensure the navidrome server is up and running.

if ! pidof "$BASE/navidrome/navidrome" >/dev/null; then
	/etc/init.d/navidrome start
fi

# Look for a newer release. One API call, both values come from the same answer.
# -T: give up on a server that stops answering (busybox wget and
# uclient-fetch both take it) instead of hanging the cron job.

RELEASE="$(wget -q -T 30 -O - "$API" 2>/dev/null || true)"
NEWID="$(printf '%s\n' "$RELEASE" | grep -o '"tag_name": *"[^"]*"' | head -n 1 | cut -d '"' -f 4)"
URL="$(printf '%s\n' "$RELEASE" | grep -o '"browser_download_url": *"[^"]*_linux_'"$ARCH"'\.tar\.gz"' | head -n 1 | cut -d '"' -f 4)"

if [ -z "$NEWID" ] || [ -z "$URL" ] || [ "$OLDID" = "$NEWID" ]; then
	exit 0
fi

# set -e stops at a failed download or extraction: remove the archive then too.
trap 'rm -f "$ARCHIVE"' EXIT
rm -f "$ARCHIVE"
wget -q -T 30 -O "$ARCHIVE" "$URL"
tar -xzf "$ARCHIVE" -C "$STAGING/" navidrome
rm -f "$ARCHIVE"
sync

# A freshly extracted binary is waiting in staging: deploy it.

if [ -f "$STAGING/navidrome" ]; then
	chmod +x "$STAGING/navidrome"
	/etc/init.d/navidrome stop
	sync
	sleep 5
	cp "$BASE/navidrome/navidrome" "$BASE/navidrome-backup"
	cp "$BASE/navidrome/navidrome.db" "$BASE/"
	cp "$BASE/navidrome/navidrome.toml" "$BASE/"
	rm -f "$BASE/navidrome/navidrome"
	mv "$STAGING/navidrome" "$BASE/navidrome/"
	printf '%s\n' "$NEWID" > "$BASE/ID"
	sync
	/etc/init.d/navidrome start
fi
