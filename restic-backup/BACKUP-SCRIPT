#!/usr/bin/env zsh
#
# Encrypted restic backup to a Google Drive folder mounted with
# google-drive-ocamlfuse.
#
# Requirements:
#
# google-drive-ocamlfuse
#
# fusermount3
#
# restic
#
# Restic repository on google drive, mounted locally
#
# Create restic repository example:
#
# 1. mkdir $HOME/GoogleDriveBackup
#
# 2. execute in terminal "google-drive-ocamlfuse -label YOUNAMEIT" to authorize it with google drive via web browser
#
# 3. mount google drive locally: google-drive-ocamlfuse -label YOUNAMEIT $HOME/GoogleDriveBackup
#
# 4. create a subdirectory for the restic repository while gdrive is mounted: mkdir $HOME/GoogleDriveBackup/ryzen-backup
#
# 5. Initialise a restic repo in it: restic init --compression max --cleanup-cache --repository-version latest -r $HOME/GoogleDriveBackup/ryzen-backup
#
# 6. $HOME/GoogleDriveBackup/ryzen-backup will contain the backups - encrypted in your google drive.
#
# Then set label, mount and RESTIC_REPOSITORY below to the values you used,
# and list what to back up in ~/restic-includes.conf (and what to skip in
# ~/restic-excludes.conf), one path or pattern per line.

# Settings:

label="ivangotoy84"
mount="$HOME/GoogleDriveBackup"
export RESTIC_REPOSITORY="${mount}/ryzen-backup"
export RESTIC_CACHE_DIR="$HOME/.cache/restic"
# Don't encrypt like everyone's watching, host is secure - ~/.restic-password contains the repo password in plain text.
export RESTIC_PASSWORD_FILE="$HOME/.restic-password"
includes="$HOME/restic-includes.conf"
excludes="$HOME/restic-excludes.conf"
keep_last=10

# Check for tools:

if ! command -v google-drive-ocamlfuse &>/dev/null; then
	printf 'google-drive-ocamlfuse not found!!! Visit https://github.com/astrada/google-drive-ocamlfuse/wiki/Installation\n'
	exit 1
fi

if ! command -v fusermount3 &>/dev/null; then
	printf 'fusermount3 not found!!! package fuse3 ubuntu/redhat/arch; Google for: install fuse3 linux\n'
	exit 1
fi

if ! command -v restic &>/dev/null; then
	printf 'restic not found!!! Visit https://restic.readthedocs.io/en/latest/020_installation.html\n'
	exit 1
fi

restic=(restic --cleanup-cache --compression max -q)

# Terminal colors:
lightred='\033[1;31m'
lightgreen='\033[1;32m'
yellow='\033[1;33m'
lightcyan='\033[1;36m'
lightblue='\033[1;34m'
red='\033[0;31m'
green='\033[0;32m'
cyan='\033[0;36m'
brown='\033[0;33m'
purple='\033[0;35m'
nocolor='\033[0m'

# step COLOR TEXT: one "#### date - TEXT!" progress line.
step() {
	printf "#### %s - ${1}%s${nocolor}!\n####\n" "$(date +'%d %B %Y %Hh:%Mm:%Ss')" "$2"
}

is_mounted() {
	mount | grep -q -- " $mount "
}

# fail TEXT: report a failed step, unmount the drive, stop.
fail() {
	printf "#### %s - ${red}%s FAILED${nocolor}!\n" "$(date +'%d %B %Y %Hh:%Mm:%Ss')" "$1"
	is_mounted && fusermount3 -u "$mount" &>/dev/null
	exit 1
}

start=$(date +%s)
printf "\n#### %s - ${lightred}BACKUP STARTED${nocolor}!\n####\n" "$(date +'%d %B %Y %Hh:%Mm:%Ss')"

mkdir -p "$RESTIC_CACHE_DIR"

if [[ ! -d "$mount" ]]; then
	printf 'Mount directory %s not found, fix "mount" at the top of this script!!!\n' "$mount"
	exit 1
fi

# Start from a fresh mount every time.
is_mounted && fusermount3 -u "$mount" &>/dev/null
step "$lightgreen" "REPO DIRECTORY MOUNT"
google-drive-ocamlfuse -label "$label" "$mount" &>/dev/null || fail "GOOGLE DRIVE MOUNT"

if [[ ! -d "$RESTIC_REPOSITORY" ]]; then
	printf 'Restic repository %s not found, fix "RESTIC_REPOSITORY" at the top of this script!!!\n' "$RESTIC_REPOSITORY"
	fail "REPOSITORY CHECK"
fi

# Check that the folder is an initialised restic repo:

if [[ ! -f "${RESTIC_REPOSITORY}/config" ]]; then
	printf 'Folder not a restic repo, please read the steps at the top: head -32 %s\n' "$0"
	fail "REPOSITORY CHECK"
fi

$restic unlock &>/dev/null || fail "UNLOCK"
step "$yellow" "UNLOCK COMPLETE"
# Exit code 3 means a snapshot was made but some files could not be read.
$restic backup --files-from="$includes" --exclude-file="$excludes" &>/dev/null
rc=$?
(( rc == 0 || rc == 3 )) || fail "BACKUP"
(( rc == 3 )) && step "$brown" "BACKUP INCOMPLETE, SOME FILES COULD NOT BE READ"
step "$lightcyan" "BACKUP COMPLETE"
$restic forget --keep-last "$keep_last" --prune &>/dev/null || fail "FORGET/PRUNE"
step "$lightblue" "OLDEST SNAPSHOT DELETED"
$restic unlock &>/dev/null || fail "UNLOCK"
step "$red" "REPO UNLOCKED FOR NEXT BACKUP"

fusermount3 -u "$mount" &>/dev/null
# Check that Google Drive was unmounted, try once more if not:
is_mounted && fusermount3 -u "$mount" &>/dev/null
is_mounted && fail "GOOGLE DRIVE UNMOUNT"
step "$green" "REPO GOOGLE DRIVE DIR UNMOUNTED"

end=$(date +%s)
runtime=$((end - start))
minutes="$(printf '%.2f' $((runtime / 60.0)))"
printf "#### TOTAL TIME TAKEN: ${cyan}%s SECONDS${nocolor}!\n####\n" "$runtime"
printf "#### WHICH IS: ${brown}%s MINUTES${nocolor}!\n####\n" "$minutes"
printf "#### %s - ${purple}BACKUP ENDED${nocolor}!\n\n" "$(date +'%d %B %Y %Hh:%Mm:%Ss')"

exit 0
