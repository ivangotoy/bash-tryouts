#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# This is a hastily written script that "might" update x86 openwrt images.
# It runs on the build machine (zsh), not on the router; the only command
# sent to the router is a plain POSIX sysupgrade call over ssh.
#
# Assumptions:
# - ssh passwordless login to the openwrt router (ssh host alias "router")
#   works for the account building OpenWrt.
# - wget; zsh; openwrt git source tree in ~/Downloads/openwrt - adjust these to your setup.
# - variables defined in CAPS are this script's settings, not system variables.

# Timing details (for my personal use - benchmarking various cpus and setups, irrelevant for fw updates)

START=$(date +%s)
OPENWRT="/home/$USER/Downloads/openwrt"
IMAGE="openwrt-x86-64-generic-ext4-combined.img"
FIRMWARE="$OPENWRT/bin/targets/x86/64/$IMAGE"
ROUTER="router"
JOBS="${JOBS:-$(nproc)}"

say() {
	printf '%s %s\n\n' "$(date +"%Hh:%Mm:%Ss")" "$1"
}

online() {
	local try
	for try in {1..$1}; do
		wget -q --timeout=1 --spider https://google.bg && return 0
		sleep 1
	done
	return 1
}

if online 10; then
	say "There is Internet!"
else
	say "No internet! Cannot continue!"
	exit 1
fi

# UPDATE, CLEAN FIRMWARE AND BUILD A NEW ONE:

cd "$OPENWRT" || { say "No OpenWrt source tree in $OPENWRT! Cannot continue!"; exit 1; }
say "Updating sources..."
if ! { git pull && ./scripts/feeds update -a && ./scripts/feeds install -a } &>/dev/null; then
	say "Updating sources failed (git pull or feeds)! Nothing built. Run them by hand in $OPENWRT to see why."
	exit 1
fi
say "Cleaning previous build..."
make clean &>/dev/null

# Runs make with $JOBS jobs: the number of cpu threads (nproc) unless JOBS is
# set in the environment, e.g. JOBS=8 ruter-upgrade.

say "Building firmware. This will take some time. And cpu cycles... and ram."
if ! make -j"$JOBS" &>/dev/null; then
	say "BUILD ERROR! Run make -j1 V=s in $OPENWRT to see why."
	exit 1
fi
sync &>/dev/null

# CHECK FOR THE NEWLY BUILT FIRMWARE FILE:

if [[ ! -f "$FIRMWARE" ]]; then
	say "NO FIRMWARE FILE FOUND - BUILD ERROR!"
	exit 1
fi
say "Done building, let's flash it."

if ! scp "$FIRMWARE" "$ROUTER:/tmp/" &>/dev/null; then
	say "Copying firmware to $ROUTER failed! Nothing flashed."
	exit 1
fi

# The router reboots during sysupgrade, so the ssh exit status is meaningless.
ssh "$ROUTER" "sysupgrade -q /tmp/$IMAGE" &>/dev/null

sleep 15

if online 20; then
	say "Router is back online!"
	rc=0
else
	say "Check your internet connection!"
	rc=1
fi

END=$(date +%s)
RUNTIME=$((END - START))
say "Upgrade took: $RUNTIME seconds"
printf 'Which means:\n\n%d minutes\n' $((RUNTIME / 60))

exit $rc
