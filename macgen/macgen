#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
#
# https://digtvbg.com/
#
# Generates all 16.7 million (16^6) MAC addresses for a given 3 byte
# device prefix (OUI), shuffled and uppercase, into one file (colons in the
# prefix become dashes in the file name), and optionally splits that file
# into smaller parts.
#
# Educational purposes only, definitely not for device spoofing/scanning endeavors.
#
# Needs: zsh, shuf, tr, split (GNU coreutils for --numeric-suffixes).

export LC_ALL=C
export LANG=C
setopt pipefail

printf 'Example device prefix is: 00:1A:79: or 78:A3:52: which is 9 symbols.\n\nProvide 9 symbols prefix:\n\n'

read -r PREFIX

if [[ ! "$PREFIX" =~ '^([0-9A-Fa-f]{2}:){3}$' ]]; then
	printf 'Device prefix must look like 00:1A:79: (3 hex bytes, each followed by a colon).\n\nExiting now.\n'
	exit 1
fi

start=$(date +%s)

hex=({0..9} {a..f})
BIGFILE="${PREFIX}all-macs-16M.txt"
WORDLIST="${BIGFILE//:/-}"
PARTPREFIX="${PREFIX//:/-}"

printf 'Selected device prefix is %s\n\nPlease, wait a sec...\n\n' "$PREFIX"
printf '%s\n' "$PREFIX"${^hex}${^hex}:${^hex}${^hex}:${^hex}${^hex} | shuf | tr '[:lower:]' '[:upper:]' > "$WORDLIST" || {
	printf 'Generating %s failed (see the error above).\n' "$WORDLIST" >&2
	exit 1
}

end=$(date +%s)
runtime=$((end - start))
printf '16 MILLION MACs GENERATED AND RANDOMIZED FOR: %s SECONDS!\n\nYou can find them in %s\n\n' "$runtime" "$WORDLIST"

printf 'Continue with splitting the big file?\n\n"1" for yes, "2" for no:\n\n'

select answer in "Yes" "No"; do
	case $answer in
		Yes)
			printf 'How to split the 16M macs file?\n\nValid choices are:\n\n1) for 500k macs per file\n\n2) for 1M macs per file\n\n3) for 256k macs per file\n\nSelect 1 2 or 3 - other value for exit:\n'
			read -r choice
			case $choice in
				1) lines=500000 ; tag=500k ; label=500k ;;
				2) lines=1000000 ; tag=1m ; label=1M ;;
				3) lines=256000 ; tag=256k ; label=256k ;;
				*) printf 'Exiting now.\n\nBye!\n' ; exit 0 ;;
			esac
			printf 'Splitting %s to smaller %s lines each.\n' "$WORDLIST" "$label"
			split -l "$lines" -a 2 --numeric-suffixes=1 --additional-suffix=.txt "$WORDLIST" "${PARTPREFIX}${tag}PART"
			break ;;
		No)
			printf 'Exiting now.\n'
			exit 0 ;;
		*)
			printf 'I guess 1 or 2 were too confusing.\n\nExiting now.\n'
			exit 0 ;;
	esac
done
