#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# Tooling used: zsh, curl, jq, and column
#
# This script does these things:
#
# Shows a list of country to number mappings for NORDVPN
#
# Asks the user to select a number
#
# Pulls valuable details for the country represented by the selected number.
#
# The number must be a numeric country ID from the list, anything else is a
# usage error.

export LC_ALL=C
export LANG=C
setopt pipefail

limit=20
curl_opts=(--max-time 30 --tlsv1.3 --silent --show-error --fail --compressed -4)

# Show countries:
printf 'AVAILABLE COUNTRIES + THEIR NUMERIC CODES:\n'
printf '#########################################:\n'
if ! curl $curl_opts "https://api.nordvpn.com/v1/servers/countries" | jq --raw-output '.[] | [.id, .name] | @tsv' | column -c 70; then
	printf 'Could not get the country list from the NordVPN API.\n' >&2
	exit 1
fi

printf 'PLEASE ENTER YOUR DESIRED COUNTRY NUMERIC CODE AND PRESS ENTER:\n'
read -r country_id
if [[ ! "$country_id" =~ '^[0-9]+$' ]]; then
	printf 'Usage: enter one of the numeric country IDs listed above, got "%s".\n' "$country_id" >&2
	exit 2
fi

printf 'HERE ARE THE WIREGUARD SERVERS FROM COUNTRY ID %s SORTED BY LOAD:\n' "$country_id"

if ! LIST="$(curl $curl_opts "https://api.nordvpn.com/v1/servers?filters\[servers_technologies\]\[identifier\]=wireguard_udp&filters\[country_id\]=${country_id}&limit=${limit}" | jq --raw-output --argjson limit "$limit" 'sort_by(.load) | limit($limit; .[]) | [.hostname, .station, ([.technologies[]?.metadata[]? | select(.name == "public_key") | .value][0] // ""), .load] | "\(.[0])  \(.[1])  \(.[2])  \(.[3])"')" || [[ -z "$LIST" ]]; then
	printf 'Could not get the server list from the NordVPN API.\n' >&2
	exit 1
fi

printf 'HOST IP PUBKEY LOAD\n%s\n' "$LIST" | column -tW 3
printf 'PORT NUMBER IS ALWAYS: 51820\n'
