#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# Tooling used: zsh, curl, jq, sed, rg, systemctl
#
# Switches the WireGuard tunnel to the least loaded NordVPN server in
# Bulgaria (country id 33) when the one in use is no longer the best.
#
# WireGuard should be properly configured with a valid/paid account key:
# /etc/wireguard/bg.conf (see bg.conf in this directory) is managed by
# wg-quick@bg, and its "Endpoint = bgNN.nordvpn.com:51820" and
# "PublicKey = ..." lines are what this script edits: each server has its
# own key, so both are switched together.

export LC_ALL=C
export LANG=C
setopt pipefail

file="/etc/wireguard/bg.conf"
country_id=33
curl_opts=(--max-time 30 --tlsv1.3 --silent --show-error --fail --compressed -4)

# CHECK ROOT ACCESS:

if [[ "$EUID" -ne 0 ]]; then
	printf 'This script must be run as root!\n'
	exit 1
fi

if [[ ! -f "$file" ]]; then
	printf 'Config file %s could not be found, please investigate!\n' "$file"
	exit 1
fi

# $old is the NordVPN server in use, e.g. "bg50", taken from the Endpoint line.

old="$(rg -oNr '$1' '^\s*Endpoint\s*=\s*(bg[0-9]+)\.nordvpn\.com' "$file" | head -n 1)"

# $oldkey is the server public key in use, from the PublicKey line.

oldkey="$(rg -oNr '$1' '^\s*PublicKey\s*=\s*(\S+)' "$file" | head -n 1)"

# $new is the least loaded NordVPN WireGuard server in the country and
# $newkey its WireGuard public key, both from the same API answer - jq magic.

best="$(curl $curl_opts "https://api.nordvpn.com/v1/servers?filters\[servers_technologies\]\[identifier\]=wireguard_udp&filters\[country_id\]=${country_id}&limit=16" | jq --raw-output 'sort_by(.load) | .[0] // empty | "\(.hostname) \([.technologies[]?.metadata[]? | select(.name == "public_key") | .value][0] // "")"')"
new="${${best%% *}%%.*}"
newkey="${best#* }"

printf 'CURRENT IP IS: %s\n' "$(curl $curl_opts checkip.amazonaws.com)"

if [[ ! "$old" =~ '^bg[0-9]+$' ]]; then
	printf 'No bgNN.nordvpn.com Endpoint found in %s, no changes will be made.\n' "$file"
	exit 1
fi

if [[ ! "$new" =~ '^bg[0-9]+$' ]]; then
	printf 'Could not get the least loaded server from the NordVPN API, no changes will be made.\n'
	exit 1
fi

# A WireGuard public key is 32 bytes in base64: 43 characters plus "=".
if [[ ! "$newkey" =~ '^[A-Za-z0-9+/]{43}=$' ]]; then
	printf 'No valid public key for %s in the NordVPN API answer, no changes will be made.\n' "$new"
	exit 1
fi

# If there is a less loaded (better) server - use it, else do nothing.

if [[ "$old" != "$new" || "$oldkey" != "$newkey" ]]; then
	sed -i -E -e "s/^(\s*Endpoint\s*=\s*)${old}\.nordvpn\.com/\1${new}.nordvpn.com/" \
		-e "s|^(\s*PublicKey\s*=\s*).*|\1${newkey}|" "$file"
	if [[ "$old" != "$new" ]]; then
		printf 'Changing server %s with the less loaded server %s.\n' "$old" "$new"
	else
		printf 'Server %s is still the best, updating its public key.\n' "$new"
	fi
	if ! systemctl restart wg-quick@bg; then
		printf 'Restarting wg-quick@bg failed, check: systemctl status wg-quick@bg\n'
		exit 1
	fi
else
	printf 'Server %s is still the best in the group no changes will be made.\n' "$old"
fi
printf 'NEW IP IS: %s\n' "$(curl $curl_opts checkip.amazonaws.com)"
