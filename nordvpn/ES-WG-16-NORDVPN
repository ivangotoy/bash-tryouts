#!/usr/bin/env zsh
#
# Ivan Angelov ivangotoy@gmail.com
# https://digtvbg.com/
#
# Tooling used: zsh, curl, jq, and column
#
# Asks the NordVPN API for servers that support the WireGuard protocol,
# from Spain (country id 202), up to 16 of them, sorted by load,
# and prints them in columns: hostname, IP address, public key, load.

export LC_ALL=C
export LANG=C
setopt pipefail

country_id=202
limit=16
api="https://api.nordvpn.com/v1/servers?filters\[servers_technologies\]\[identifier\]=wireguard_udp&filters\[country_id\]=${country_id}&limit=${limit}"

red=$(tput setaf 1 2>/dev/null)
green=$(tput setaf 2 2>/dev/null)
normal=$(tput sgr0 2>/dev/null)

if ! servers="$(curl --max-time 30 --tlsv1.3 --silent --show-error --fail --compressed -4 "$api" | jq --raw-output --argjson limit "$limit" 'sort_by(.load) | limit($limit; .[]) | [.hostname, .station, (.technologies | .[].metadata | .[].value), .load] | "\(.[0]) \(.[1]) \(.[2]) \(.[3])"')" || [[ -z "$servers" ]]; then
	printf 'Could not get the server list from the NordVPN API.\n' >&2
	exit 1
fi

{
	printf '%sHOSTNAME: IP-ADDRESS: PUBLIC-KEY: LOAD:%s\n' "$red" "$normal"
	printf '%s%s%s\n' "$green" "$servers" "$normal"
} | column -t
printf '\nPORT NUMBER IS ALWAYS: 51820\n'
